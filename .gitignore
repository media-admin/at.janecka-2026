# ============================================
# WORDPRESS CORE
# ============================================
/cms/wp-admin/
/cms/wp-includes/
/cms/wp-*.php
/cms/xmlrpc.php
/cms/readme.html
/cms/license.txt

# ============================================
# WORDPRESS CONFIG
# ============================================
/cms/wp-config.php
/cms/wp-config-local.php
/cms/wp-config-staging.php
/cms/wp-config-production.php

# ============================================
# CONTENT
# ============================================
/cms/wp-content/uploads/
/cms/wp-content/upgrade/
/cms/wp-content/cache/
/cms/wp-content/w3tc-config/
/cms/wp-content/updraft/

# ============================================
# PLUGINS – alles ignorieren, nur Projekt-Plugin versionieren
# (media-lab-* werden zentral im Starter Kit verwaltet)
# ============================================
/cms/wp-content/plugins/*
!/cms/wp-content/plugins/janecka-juweliere-project/

# ============================================
# LANGUAGES – Auto-Updates von Core/Plugins nicht versionieren
# (Loco-Eigenübersetzungen bleiben versioniert, falls vorhanden)
# ============================================
/cms/wp-content/languages/*
!/cms/wp-content/languages/loco/

# ============================================
# BACKUP-PLUGIN (ML Backup)
# ============================================
/cms/wp-content/mlbkp-*/

# ============================================
# THEMES
# ============================================
/cms/wp-content/themes/twenty*/

# Juwelier Janecka Theme (wird versioniert)
!/cms/wp-content/themes/juwelier-janecka/

# Build-Artefakte innerhalb des Themes
/cms/wp-content/themes/*/assets/dist/
/cms/wp-content/themes/juwelier-janecka/assets/hot

# ============================================
# BUILD & DEPENDENCIES
# ============================================
node_modules/
npm-debug.log*
yarn-error.log*
# package-lock.json und yarn.lock: optional – je nach Team-Entscheidung
/vendor/

# ============================================
# OS & IDE
# ============================================
.DS_Store
Thumbs.db
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ============================================
# LOGS & TEMP
# ============================================
*.log
/cms/wp-content/debug.log
*.tmp
*.temp
.cache/

# ============================================
# BACKUPS & DATENBANK
# ============================================
*.backup
*.bak
*-backup/
*.sql
*.sql.gz
*.zip
*.tar.gz
docs-backup/

